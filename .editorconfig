root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4

# --- Spacing (Microsoft / .NET industry defaults) ---
# Target style:
#   if (condition)
#   Method(arg1, arg2)
#   for (int i = 0; i < n; i++)
#   (int)x
#   x + y
#
# Space after if / while / for / foreach:
csharp_space_after_keywords_in_control_flow_statements = true
# No spaces inside ( ... ) for control flow, casts, expressions:
csharp_space_between_parentheses = false
# No spaces inside method call / declaration parameter lists:
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
# Casts, commas, dots, operators, for-semicolons, brackets, inheritance colons:
csharp_space_after_cast = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_around_binary_operators = before_and_after
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_around_declaration_statements = false
csharp_space_before_open_square_brackets = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_square_brackets = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true

# --- Var preferences ---
# Prefer explicit type instead of var
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0008.severity = warning

# Prefer target-typed new ( new() ) when the type is already known
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_diagnostic.IDE0090.severity = warning

# Do not suggest Primary Constructors for classes/structs (keep classic constructors)
csharp_style_prefer_primary_constructors = false:silent

# --- Naming conventions ---
# Private instance fields: _camelCase (DI dependencies, state).
#   Example: private readonly IAppDbConnection _db;
# Const and static readonly fields: PascalCase (.NET convention for constants).
#   Example: private const string MigrationSchemaName = "tax";
#   Example: private static readonly TimeSpan DefaultTimeout = TimeSpan.FromSeconds(30);
# Const / static readonly rules take precedence over the private field rule.

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# Keep const fields in PascalCase, e.g. MigrationSchemaName.
dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.applicable_accessibilities = private, internal, protected, protected_internal, private_protected, public
dotnet_naming_symbols.const_fields.required_modifiers = const
dotnet_naming_rule.const_fields_should_be_pascal_case.symbols = const_fields
dotnet_naming_rule.const_fields_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.const_fields_should_be_pascal_case.severity = warning

# Keep static readonly fields in PascalCase, e.g. DefaultTimeout.
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = private, internal, protected, protected_internal, private_protected, public
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_fields_should_be_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_should_be_pascal_case.severity = warning

# Keep non-const private instance fields with underscore prefix, e.g. _repository.
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.severity = suggestion

[*.{csproj,xml,json}]
indent_style = space
indent_size = 2
