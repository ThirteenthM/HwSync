<Window x:Class="HwSync.Client.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HwSync — сравнение папок" Width="1060" Height="840" MinWidth="820" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="28" Background="#F3F5F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" IsEnabled="{Binding CanEditConnection}" Margin="0,0,0,8" AutomationProperties.Name="Профиль папки"/>
            <TextBlock Text="HwSync" FontSize="30" FontWeight="SemiBold" Foreground="#19324A" />
            <TextBlock Text="Сравнение папок • сервер → клиент" Foreground="#58697B" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Адрес сервера" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnection}" AutomationProperties.Name="Адрес сервера" />
                <Button Grid.Row="1" Grid.Column="1" Content="Проверить связь" Command="{Binding ConnectCommand}" Margin="12,0,0,0" Click="Button_Click"/>
                <TextBlock Grid.Row="2" Text="Каталог на сервере (абсолютный путь)" Margin="0,14,0,6"/>
                <TextBox Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnection}" AutomationProperties.Name="Каталог на сервере" />
                <TextBlock Grid.Row="4" Text="Каталог на клиенте (абсолютный путь)" Margin="0,14,0,6"/>
                <TextBox Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding ClientRootPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnection}" AutomationProperties.Name="Каталог на клиенте"/>
                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Сравниваются относительные пути, размеры и время изменения. Файлы не изменяются." Foreground="#58697B" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <WrapPanel Margin="0,0,0,14">
                <Button Content="Сравнить папки" Command="{Binding StartCommand}" Background="#214E78" Foreground="White"/>
                <Button Content="Копировать отсутствующие" Command="{Binding CopyCommand}"/>
                <Button Content="Отменить" Command="{Binding CancelCommand}"/>
                <Button Content="Продолжить опрос" Command="{Binding ResumeCommand}"/>
            </WrapPanel>
            <TextBlock Text="{Binding Status}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBox Text="{Binding JobId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,4" Foreground="#58697B" AutomationProperties.Name="Идентификатор задания"/>
            <TextBlock Text="{Binding Error}" Foreground="#A22222" TextWrapping="Wrap" MaxHeight="80"/>
        </StackPanel>
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ResultSummary}" FontWeight="SemiBold" Margin="4,0,0,12"/>
                <DataGrid ItemsSource="{Binding Changes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="32"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Результаты сканирования">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Различие" Binding="{Binding Kind}" Width="150"/>
                        <DataGridTextColumn Header="Файл" Binding="{Binding Path}" Width="*" MinWidth="300"/>
                        <DataGridTextColumn Header="Клиент, байт" Binding="{Binding PreviousSize}" Width="115"/>
                        <DataGridTextColumn Header="Сервер, байт" Binding="{Binding CurrentSize}" Width="115"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="4" Text="Копируются только отсутствующие файлы. Различающиеся и клиентские файлы сохраняются." Foreground="#58697B" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
    </Grid>
</Window>
