<Window x:Class="HwSync.Windows.Admin.Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HwSync — управление сервером" Width="1200" Height="850"
        MinWidth="900" MinHeight="650" Background="#F2F5F8" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="BorderBrush" Value="#D8E0E8" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC" />
        </Style>
    </Window.Resources>
    <Grid Margin="24" Background="#F2F5F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="HwSync · управление сервером" FontSize="27" Foreground="#193D5D" FontWeight="SemiBold" />
            <TextBlock Text="Настройки, папки и история удалений • режим просмотра" Foreground="#526B80" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Адрес сервера" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" Padding="8"
                             IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Адрес сервера" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Персональный ключ доступа" Margin="0,0,0,6" />
                    <PasswordBox x:Name="AccessKey" PasswordChanged="AccessKeyChanged" Padding="8"
                                 IsEnabled="{Binding IsIdle}" ToolTip="При запуске ключ загружается из HWSYNC_ADMIN_ACCESS_TOKEN. Здесь можно ввести другой ключ." AutomationProperties.Name="Персональный ключ доступа" />
                </StackPanel>
                <Button Grid.Column="2" Content="Подключить / обновить" Command="{Binding ConnectCommand}" VerticalAlignment="Bottom" Margin="0" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl Grid.Row="3">
            <TabItem Header="Настройки сервера">
                <DataGrid ItemsSource="{Binding Settings}" Margin="12" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Параметр" Binding="{Binding Name}" Width="260" />
                        <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*" MinWidth="450" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Папки и похоронная книга">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="160" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Папки появляются после успешного сканирования сервером." Foreground="#526B80" Margin="0,0,0,8" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                              IsEnabled="{Binding IsIdle}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Папка на сервере" Binding="{Binding Path}" Width="*" MinWidth="360" />
                            <DataGridTextColumn Header="Файлов в снимке" Binding="{Binding FileCount}" Width="145" />
                            <DataGridTextColumn Header="Активных удалений" Binding="{Binding ActiveDeletionCount}" Width="155" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12">
                        <Button Content="Показать историю" Command="{Binding LoadHistoryCommand}" />
                        <Button Content="Следующие 100 записей" Command="{Binding LoadMoreCommand}" />
                    </StackPanel>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Deletions}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="55" />
                            <DataGridTextColumn Header="Файл" Binding="{Binding Path}" Width="*" MinWidth="180" />
                            <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="105" />
                            <DataGridTextColumn Header="Удалён (UTC)" Binding="{Binding DeletedAtUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="165" />
                            <DataGridTextColumn Header="МБ" Binding="{Binding SizeMb, StringFormat=F3}" Width="85" />
                            <DataGridTextColumn Header="Изменён (UTC)" Binding="{Binding ModifiedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="165" />
                            <DataGridTextColumn Header="Участник-источник" Binding="{Binding OriginParticipantId}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Отменить запрос" Command="{Binding CancelCommand}" Margin="12,0,0,0" />
            <TextBlock Text="Журнал хранит сведения об удалениях, а не содержимое файлов. Ключ доступа не сохраняется."
                       VerticalAlignment="Center" Foreground="#526B80" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
