<Window x:Class="HwSync.Windows.Client.Application.DeletionReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение удаления" Width="1050" Height="570" MinWidth="750" MinHeight="400"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="16" Background="White">
        <TextBlock DockPanel.Dock="Top" Text="Выберите копии для удаления без помещения в корзину. Снятая галочка оставляет копию без изменений."
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ConfirmButton" Content="Удалить выбранные" Click="ConfirmClick" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Отмена" IsCancel="True" IsDefault="True" Padding="16,8"/>
            </StackPanel>
            <TextBlock x:Name="SelectionSummary" VerticalAlignment="Center"/>
        </DockPanel>
        <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Удалять" Width="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Checked="SelectionChanged" Unchecked="SelectionChanged" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Папка" Binding="{Binding File.Folder}" Width="*" MinWidth="160"/>
                <DataGridTextColumn Header="Имя файла" Binding="{Binding File.Name}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="Сторона" Binding="{Binding File.Side}" Width="85"/>
                <DataGridTextColumn Header="Дата (UTC)" Binding="{Binding File.ModifiedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="165"/>
                <DataGridTextColumn Header="МБ" Binding="{Binding File.SizeMegabytes, StringFormat={}{0:0.000}}" Width="85"/>
                <DataGridTemplateColumn Header="Содержимое" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Просмотр" Click="PreviewClick" Padding="8,4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>